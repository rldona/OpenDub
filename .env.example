# Only needed with --backend api. With --backend cli your Claude Code session is used.
ANTHROPIC_API_KEY=

# When YouTube asks to confirm you aren't a bot: download as your own YouTube session,
# with this browser's cookies (firefox, chrome, chrome:Profile 1…). Used by the web page
# and as the CLI's default for --cookies-from-browser.
# OPENDUB_COOKIES_FROM_BROWSER=firefox
